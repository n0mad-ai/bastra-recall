exports[`#1532 golden master — bastra --help 1`] = `
"bastra <version> — install bastra-recall across AI clients\\n\\nUsage:\\n  bastra                     Show status panel (version, update, daemon, vault)\\n  bastra <command> [surface] [options]\\n  bastra <command> --help    What that one command does, and its options\\n\\nCommands:\\n  install                    Guided setup (interactive): pick vault, clients,\\n                             semantic recall from selection lists\\n  install <surface|all>      Register bastra-recall with the AI client\\n  install claude-desktop --extension\\n                             Hand the .mcpb Desktop Extension to Claude\\n                             Desktop instead (logo + vault picker; one\\n                             Install click stays in Desktop's dialog)\\n  uninstall <surface|all>    Remove the registration (the shared skill is\\n                             removed once no surface references it anymore)\\n  update                     brew or npm upgrade (whichever installed it) +\\n                             re-register + daemon restart. From a source checkout: run it\\n                             after pulling AND building (it verifies the build,\\n                             it never runs one).\\n  address <status|setup [name]|remove>  Your own assistant name as a browser address.\\n                             System/browser setup only with your consent.\\n  autostart <on|off|status>  Keep the daemon running permanently (off by\\n                             default — it otherwise starts on demand and shuts\\n                             down after 30 min idle). 'on' installs a service;\\n                             a hand-written one is never replaced without --force\\n  tasks <list|get|create|review|edit|snooze|acknowledge|resolve|cancel|rearm|delete>\\n                             Enabled by default; disable in Settings or with BASTRA_TASKS=0.\\n                             Owner token prompt; JSON input file. Add agent before\\n                             the file to use explicit BASTRA_TASK_TOKEN.\\n  codex [Codex options]      Start a Codex CLI chat with active task delivery.\\n  suggestions <reject|reset>  Explicit decisions on exact project save proposals\\n  drafts <list|purge|undo|reject>  Inspect or clear local session drafts\\n  patches <list|add <file>|remove <id>|status>\\n                             Local patches that survive an update: an ordered\\n                             series reapplied onto the fresh install. One that\\n                             upstream has absorbed is retired, one that no\\n                             longer applies is set aside and reported — never\\n                             forced. 'status' probes them against what is\\n                             installed right now.\\n  embeddings <on|off|status> Semantic recall (multilingual vector search):\\n                             'on' sets up Ollama + the embeddinggemma model\\n                             (~620 MB) and persists the choice; 'off' returns\\n                             to BM25 keyword-only; 'status' shows the effective\\n                             provider and how it was resolved\\n  models [status|recommend|  Local text model for memory rewriting (doc2query +\\n    set <tag>]               rerank). 'status' shows the active model + this\\n                             machine's RAM-tier recommendation; 'set' pulls a\\n                             model + persists it (e.g. gemma4:12b on a 24 GB+ box)\\n  models <switch|later|      Answer a release's model recommendation: switch to\\n    dismiss> <id> [model]    it (pulled + tested first), ask again in 7 days,\\n                             or not for this recommendation. The notice prints\\n                             the exact command\\n  config get <key>           Read a setting (e.g. update.mode)\\n  config set <key> <value>   Write a setting (update.mode = notify|auto|off,\\n                             docs.mode = off|suggest|auto, docs.language = en|de|…)\\n  token [rotate|clear]       Print the REST API token (mint on first use) for\\n                             browser/REST clients; 'rotate' issues a fresh one,\\n                             'clear' removes it (locks out browser/REST clients)\\n    [--origin <url>]         With 'token': also allowlist this browser Origin\\n                             (e.g. https://bastra.io) so the web app can reach\\n                             the daemon — no plist/env editing needed\\n  oauth [list|revoke <id|all>]\\n                             Remote MCP clients approved via OAuth (ChatGPT,\\n                             claude.ai connectors); 'revoke' cuts one or all off\\n  account <setup|status|reset-password|devices|revoke <handle>|logout-all|unlock>\\n                             The web UI account: create it (hidden password\\n                             prompt), see sessions and locks, end sessions,\\n                             clear sign-in locks, set a new password\\n  ui remote <on <https-address>|off|status>\\n                             Open the web UI to the internet behind your own\\n                             tunnel (sign-in required); 'off' ends all public\\n                             sessions at once. Plain 'bastra ui' = 'bastra map'\\n  code <enable|disable|index|rebuild|status>\\n                             Code awareness per repository (experimental):\\n                             shows an agent what depends on a file before it\\n                             edits one, and adds find_code. Off until enabled;\\n                             Graphify builds a local code map, sends nothing\\n                             anywhere (macOS/Linux)\\n  commons <enable|update|disable|status|verify>\\n                             Bastra Commons: community-proven recipes as a\\n                             read-only second recall index (git-synced);\\n                             'verify' submits a works/fails record as a PR\\n  bridges <enable|disable|status|language|live|mint|harvest>\\n                             Shared learned-recall: opt-in vocabulary\\n                             bridges that widen recall (off by default;\\n                             when on, query expansion runs in shadow until 'live on').\\n                             'mint' = bridges from acted-on reaches; 'harvest' =\\n                             deep far-slice pass with the local reranker (Teacher 2).\\n  map                        Open the vault map in the browser — an interactive\\n                             graph of your memory (local only; offers to enable\\n                             it when off). Alias: ui\\n  import <file|-> [source]   Seed the vault from another AI tool's memories\\n                             (ChatGPT/Claude/Gemini list or free text): stages\\n                             candidates in import-review.md for review — your\\n                             next AI session distills accepted ones with you;\\n                             nothing is saved without your accept.\\n                             A conversations.json data export is queued locally\\n                             instead; the AI session mines it chunk-wise\\n  import rules               Stage local rules files (CLAUDE.md, AGENTS.md,\\n                             .cursorrules, .cursor/rules/, ~/.claude/CLAUDE.md)\\n  import vault <dir> [label] Import a whole folder of memory files (e.g. a\\n                             Claude Code memory dir) into its own isolated\\n                             set under memories/imported/ — deterministic,\\n                             no per-item review, nothing existing is touched\\n  import clients             Import Claude Code's and Codex's own memory\\n                             folders the same way (one set per folder)\\n  import <mine|clear>        Print the next mining chunk for the AI session /\\n                             discard the local mining queue\\n  onboard                    5-minute interview that seeds a fresh vault:\\n                             persona-aware questions, every answer becomes a\\n                             profile memory ('onboard skip' stops the nudge)\\n  skills <list|add|remove>   Declare link targets that live on another surface\\n                             (e.g. Claude Code skills): declared ids render in\\n                             the map's skills ring instead of as unwritten\\n                             ghosts — no path, no scan, no sync\\n  feedback <bug|idea>        Open a prefilled GitHub issue form in the browser.\\n                             'bug' includes a sanitized diagnostics block\\n                             (version, OS, embedding mode, vault size — never\\n                             vault content); you review and submit it yourself\\n  archive <put|list|restore|reconcile>\\n                             Move a path into ~/.bastra/archive yourself, see\\n                             what the agent's rm moved there, put a path back,\\n                             or let old entries go\\n  trash <list|restore ID>    Archived memories (archive_memory, the vault\\n                             trash): list them, or put one back where it lived\\n  recall \\"<question>\\"        Search the vault from the terminal (same search\\n                             agents use; needs the running daemon)\\n  save --title T --type T --scope S [text]\\n                             Save a memory yourself (same checks as an agent's\\n                             save, recorded as your own instruction)\\n  reconcile [other-store]    Two copies of the same vault: which one is ahead,\\n                             per memory (dry run; --yes copies with backup,\\n                             conflicts are only listed); no argument lists\\n                             the copies it finds\\n  doctor [surface|all]       Check status of one or every surface\\n  doctor [surface|all] --fix Check status and repair missing/broken pieces\\n  doctor --replay [--days N] Send your own past prompts through recall in\\n                             shadow and report what it would have hinted\\n  status                     Check daemon and adapters status (supports --json, -q)\\n  logs                       Readable view of what the hooks and the daemon\\n                             recorded — one line per event, newest last\\n                             (-f to follow, --since 1h, --source hook|daemon)\\n  rules cursor [path]        Write Cursor's memory rules into a project\\n                             (.cursor/rules/bastra-recall.mdc). Cursor keeps\\n                             rules per repo — there is no global equivalent,\\n                             so run this once per project. 'rules remove\\n                             cursor [path]' takes it back out\\n  completion <shell>         Print a Tab-completion script (bash, zsh, fish)\\n  help                       Show this help\\n  version                    Show version\\n\\nSurfaces:\\n  claude-desktop             Claude Desktop App\\n  claude-code                Claude Code\\n  codex                      Codex + ChatGPT Desktop\\n  cursor                     Cursor\\n  all                        Every surface above\\n\\nOptions:\\n  --dry-run                  Print what would change; write nothing\\n  --vault <path>             Vault path (BASTRA_VAULT_PATH env also works)\\n  --json                     Output status in JSON format (status command only)\\n  -q, --quiet                Suppress output, return exit code only (status command only)\\n  --yes, -y                  Skip confirmation prompts (replace a foreign statusLine)\\n  --ollama                   Set up Ollama for semantic recall without asking (installs via Homebrew, downloads ~620 MB)\\n  --no-ollama                Skip the Ollama setup (semantic recall uses BM25 keyword search)\\n  -f, --follow               Keep printing new entries as they arrive (logs only)\\n  --since <duration>         How far back to read: 30s, 10min, 2h, 1d (logs only, default 5min)\\n  --source <daemon|hook|all> Which log source to read (logs only, default all)\\n  --lines <n>                Cap the number of lines printed (logs only, default 200)\\n  --conventions              Per-session convention evidence (default window: 7d)\\n  --stats                    Aggregate per trigger lane instead of printing lines\\n                             (logs only; --since defaults to 7d)\\n  --include-eval             With --stats: also count rows marked as eval/\\n                             synthetic traffic (excluded by default, #619)\\n  --fix                      With doctor: repair non-ok surfaces (on 'all', won't set up ones never installed)\\n  --replay                   With doctor: replay your Claude Code prompts of the last\\n                             --days N days (default 14) through the live prompt lane,\\n                             nothing written; --json for the report as JSON,\\n                             --compare <report.json> to print deltas to a saved one\\n  --with-bootstrap          Add generated startup instructions (explicit consent)\\n  --no-bootstrap            Skip the startup instruction offer\\n  --no-stop-hook             Skip the Stop save-eval hook (registered by default)\\n  --stub                     Download the compiled hook client for Claude Code without asking (~70 MB)\\n  --no-stub                  Keep the node hook client — never download the compiled one (remembered)\\n  --force                    With update: install even though locally modified files\\n                             were found (they are backed up to\\n                             ~/.bastra/update-backups/<version>/ either way).\\n                             Never applies to the unattended auto-update.\\n  --help, -h                 Show this help\\n  --version, -v              Show version\\n\\nExamples:\\n  bastra install claude-desktop\\n  bastra install codex\\n  bastra install all --dry-run\\n  bastra status --json\\n  bastra doctor\\n  bastra uninstall claude-desktop\\n\\nSupported surfaces (this build): claude-desktop, claude-code, codex, cursor\\n"
`;

exports[`#1532 golden master — bastra account --help 1`] = `
"bastra account — the web UI account, its sessions and sign-in locks\\n\\nUsage:\\n  bastra account setup\\n  bastra account status\\n  bastra account reset-password\\n  bastra account devices\\n  bastra account revoke <handle>\\n  bastra account logout-all\\n  bastra account unlock\\n\\nOne account, one vault. The web UI asks for the user name and password.\\n\\n  setup           Create the first account: user name, then the password twice\\n                  (hidden). Never overwrites an existing account.\\n  status          Account present, none or damaged; active sessions, active\\n                  locks, and whether remote access is on (with its address)\\n  reset-password  New password (twice, hidden); ends every session. Also the\\n                  repair for a damaged account record.\\n  devices         Active sessions: handle, kind, origin, name, last active,\\n                  expires (no secrets)\\n  revoke          End one session by its handle (the start of it is enough\\n                  when unambiguous)\\n  logout-all      End every session\\n  unlock          Clear all sign-in locks and failed-attempt counters\\n\\nThe password is only read from the terminal, never from arguments, environment\\nor a pipe. Changes bite at once, the daemon need not restart.\\nRemote access: 'bastra ui remote --help'.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra address --help 1`] = `
"bastra address — local assistant address\\nUsage:\\n  bastra config set assistant.name Jarvis\\n  bastra address status [--json]\\n  bastra address setup [name] [--yes] [--dry-run]\\n  bastra address remove [--yes] [--dry-run]\\nOn macOS: one-time admin approval for bastra's own loopback port-80 helper and hosts.\\nNode runs as a normal user. Its own Firefox pref for the name; close Firefox first and restart it afterwards.\\nAfter setup, http://<name>/ opens once in the default browser.\\nA bare <name> is up to the browser's search/history heuristics: <name>/ or <name>.localhost is unambiguous.\\nWindows/Linux: port-80/hosts setup by an administrator; no automatic elevation.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra archive --help 1`] = `
"bastra archive — the archive behind the agent's rm\\n\\nUsage:\\n  bastra archive put <path>...        move paths into the archive (never deletes)\\n  bastra archive list                 what was archived, deleted or refused (30 days)\\n  bastra archive restore <path|ref>   put it back (a path, or a git snapshot ref / sha)\\n  bastra archive reconcile [--yes]    show (with --yes: remove) what can go\\n\\nOpt-in, off by default: bastra config set archive.enabled on (or\\nBASTRA_RM_ARCHIVES=1 in the daemon's environment, which wins). Only for hook\\ncalls marked as Claude Code (re-run bastra install once to add the marker).\\n\\nWith it on, a Claude Code Bash command made only of rm runs through bastra's\\narchiving rm, without the usual permission prompt:\\ntargets move to ~/.bastra/archive/<date>/<time-pid>/<full path>, temp dirs\\nare really removed, /, ~ and system dirs are refused. Old entries go by class,\\nchecked hourly after Bash calls: build junk after 1 day, clean git-tracked\\nafter 2, the rest after 2; the size cap never touches your own files younger\\nthan their retention. Change it (days, fractions allowed; env\\nBASTRA_ARCHIVE_RETAIN wins):\\n  bastra config set archive.retain junk=1,in-git=2,user=2\\nLimits (sizes like 5GB or 500MB; env BASTRA_ARCHIVE_CAP and\\nBASTRA_ARCHIVE_MAX_ITEM win):\\n  bastra config set archive.cap 10GB       the whole archive (default 10 GB)\\n  bastra config set archive.max-item 2GB   largest target it takes (default:\\n                                           none; off removes it). A larger one\\n                                           is refused, not archived, not deleted.\\nAnother archive directory: BASTRA_ARCHIVE_DIR. It must be your own; if it is\\nopen to others, it is closed to you alone. One of another account, or one that\\ndirectly holds a link or another account's entry, is not used, and nothing is\\narchived or removed.\\nOnly the rm part off: BASTRA_RM_SHIM=0.\\n\\nbastra archive put <path>... makes the archiving rm's move by hand, opt-in\\nor not: same archive, same restore, and temp dirs are archived too, never\\ndeleted. A user who denies Bash(rm:*) in Claude Code can allow\\nBash(bastra archive put:*) on its own; the hook never rewrites rm into it.\\n\\ngit acts that lose work (clean -f, reset --hard, checkout [<tree>] -- <paths>,\\nrestore, branch -D, stash drop|clear) are snapshotted first: clean's files\\nand any untracked file the act would overwrite go to the archive, the rest\\nis pinned under refs/bastra-archive/ and listed here too;\\n\`bastra archive restore <ref>\` puts it back. The pins show up in\\n\`git log --all\` until they expire. Only the git part off: BASTRA_GIT_SHIM=0.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra autostart --help 1`] = `
"bastra autostart — keep the daemon running, or let it start on demand\\n\\nUsage:\\n  bastra autostart status     Show what is installed and what it points at\\n  bastra autostart on         Install and start the managed service\\n  bastra autostart off        Unload and remove it\\n  bastra autostart on --force Replace a service bastra did not write\\n\\nOff by default. Without autostart the daemon starts when an AI client first\\ncalls it and shuts down again after 30 minutes idle — that is enough for\\nClaude Code, Claude Desktop and Cursor. Turn it on when you use the REST API,\\nwant the embedding model to stay warm, or simply want instant answers.\\n\\n'on' disables the idle shutdown, so the daemon stays up until you turn it off.\\n\\nA service that bastra did not write is left alone: it usually points\\nsomewhere on purpose (a source checkout, a custom model setup), and replacing\\nit would break that. --force replaces it anyway.\\n\\nmacOS uses a LaunchAgent; Windows uses a per-user Task Scheduler logon task\\nwith restart-on-failure. doctor reports a stopped task. Windows acceptance on\\na real machine is still pending. On Linux use on-demand start or a systemd\\nuser unit.\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra bridges --help 1`] = `
"bastra bridges — shared learned-recall vocabulary (opt-in)\\n\\nUsage:\\n  bastra bridges <enable|disable|status|language|live|mint|harvest>\\n\\nVocabulary bridges widen recall by connecting the words you search with the\\nwords your memories use. Off by default. Without a language setting every\\nfolder is searched; an override limits query expansion to one folder. New\\nbridges are filed by the detected language of their source query.\\n\\n  enable / disable   Turn the shared index on or off\\n  status             What is active, and how many bridges are held\\n  language           Show or set the query-language override\\n  live <on|off>      Let bridges widen the query (default off: shadow — fires\\n                     are logged, the ranking is unchanged). Switch on only for\\n                     bridges that pass 'bastra bridges verify'\\n  mint               Derive bridges from reaches you actually acted on\\n  harvest            Deep far-slice pass with the local reranker (Teacher 2)\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra code --help 1`] = `
"bastra code — code awareness for a repository (experimental)\\n\\nUsage:\\n  bastra code                        What is enabled, which Graphify, how fresh,\\n                                     and whether the daemon's automatic refresh\\n                                     is paused or stopped (and until when)\\n  bastra code enable [<dir>]         Turn it on here and build the graph once\\n  bastra code disable [<dir>]        Turn it off; the graph files stay\\n  bastra code index [<dir>]          Refresh the graph (incremental, ~2s) and\\n                                     resume a paused or stopped daemon refresh\\n  bastra code rebuild [<dir>] [--yes]\\n                                     Repair: rebuild with --force, which\\n                                     overrides Graphify's refusal to replace a\\n                                     larger graph with a smaller one\\n\\nRecall reads the graph Graphify writes and shows an agent what depends on a\\nfile before it edits one. Nothing is indexed until you enable a repository,\\nthe graph never leaves your machine, and no code is sent to an LLM.\\n\\nExperimental. It can help an agent find its way into an unfamiliar or large\\nrepository. For \\"what breaks if I change this\\" it did not beat plain search\\nin our measurements on repositories like ours, and it costs context (the\\ndependents block before edits) and background CPU (graph refreshes).\\n\\nThe graph lives in <dir>/graphify-out/ and is excluded from git locally.\\nmacOS and Linux for now.\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra codex --help 1`] = `
"bastra codex — Start an attached Codex CLI chat with active task delivery\\n\\nUsage:\\n  bastra codex [Codex options and prompt]\\n  bastra codex resume <thread-id>\\n  bastra codex -- -m <model>\\n\\nUses its own private local App Server and authenticated terminal connection.\\nNo Codex settings are changed. Existing Codex, desktop and IDE chats are not\\nattached. The last real human-used chat wins globally with Claude Code within\\ntasks.chatActiveMinutes (default 30). Tasks remain data, never execution approval.\\nmacOS notification and the board remain available. Requires Codex CLI 0.167.0\\nwith App Server Unix transport and --remote support on macOS/Linux.\\nCodex options pass through unchanged; an alternative --remote is refused.\\nMore: https://github.com/n0mad-ai/bastra-recall/wiki/Active-Chat-Notifications\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra commons --help 1`] = `
"bastra commons — community recipes as a second, read-only index\\n\\nUsage:\\n  bastra commons <enable|update|disable|status>\\n  bastra commons verify <recipe-id> <works|fails> [\\"environment note\\"]\\n\\nBastra Commons is a git-synced set of community-proven recipes, searched as a\\nsecond recall index next to your own vault. Read-only: nothing from Commons is\\never written into your memories, and your vault is never sent anywhere. Only\\n'verify' sends something out (see below).\\n\\n  enable    Clone and register the index\\n  update    Pull the latest revision\\n  disable   Unregister it (the clone stays on disk)\\n  status    Revision, size and when it was last pulled\\n  verify    Record that a recipe works or fails for you and open a pull request\\n            with that record. The PR is public: it carries the recipe id, the\\n            result, your note, a verifier id, and your OS, CPU architecture and\\n            Node version. If git or gh is missing, or the target is refused, the\\n            record stays on disk to submit by hand.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra completion --help 1`] = `
"bastra completion — Tab completion for your shell\\n\\nUsage:\\n  bastra completion <bash|zsh|fish>\\n\\nPrints the completion script to stdout; the script carries its own install\\ninstructions in a comment at the top.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra config --help 1`] = `
"bastra config — read and write settings\\n\\nUsage:\\n  bastra config get <key>\\n  bastra config set <key> <value>\\n\\nKeys:\\n  update.mode      notify | auto | off\\n  docs.mode        off | suggest | auto   (product documentation capture)\\n  docs.language    en | de | …            (language docs are written in)\\n  reflex.enabled   true | false           (reflex memories; default true)\\n  promptImpact.enabled\\n                   true | false           (change impact in prompts, experimental; default false)\\n  battery.saver    true | false           (on battery: defer background Ollama work, macOS; default false)\\n\\nSettings live next to the vault; 'bastra config get' without a value prints the\\neffective one including where it was resolved from.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra doctor --help 1`] = `
"bastra doctor — check that every piece is registered and healthy\\n\\nUsage:\\n  bastra doctor [surface|all]\\n  bastra doctor [surface|all] --fix\\n  bastra doctor --replay [--days N] [--json] [--compare <report.json>]\\n\\nChecks the daemon, the MCP forwarder path, the hook commands, the skill and the\\nstatusline for one surface or all of them. A hook whose command points at a\\nreplaced or missing runtime makes the surface non-healthy rather than counting\\nas registered (#321).\\n\\nA final \\"features\\" section lists which Recall features are on or off (memory\\nlanguage, onboarding, semantic recall, hooks and skill per client, opt-in\\nextras) with the command that turns each one on. Off features never change the\\nexit code, and --fix never switches one on.\\n\\n--replay (#702) answers a different question: how does recall behave on YOUR\\nvault with YOUR prompts? It reads your Claude Code transcripts of the last N\\ndays (default 14), sends every user turn through the running daemon's prompt\\nlane in shadow — session ids 'replay-…', no vault writes, telemetry in its own\\n'replay-YYYY-MM-DD.jsonl' that no live readout counts — and prints the share\\nof prompts with a hint, the slots taken by the ten most frequent notes, the\\nshare of system turns (task notifications, agent mail), the slots on notes the\\nagent actually loaded, bridge fires per bridge and the p50/p95 latency. Without\\ntranscripts it says \\"not evaluable\\". Without a vector arm, same transcripts\\nand settings give the same report apart from latency and timeouts; with an\\nembedding provider, hits also depend on the vector deadline and machine load,\\nand the usage-based suppression reads the live usage sidecar. To compare two settings profiles, run the daemon with the\\ncandidate env on another port and point the replay at it with\\nBASTRA_DAEMON_URL, saving each --json report; --compare prints the deltas.\\n\\nSurfaces:\\n  claude-desktop  Claude Desktop App\\n  claude-code     Claude Code\\n  codex           Codex + ChatGPT Desktop\\n  cursor          Cursor\\n  all             Every surface above\\n\\nOptions:\\n  --fix       Repair missing or broken pieces. On 'all' this will not set up a\\n              surface that was never installed\\n  --vault <path>  Check against this vault instead of the configured one\\n  --replay    Replay your own prompts through recall in shadow (see above)\\n  --days <n>  With --replay: how many days of transcripts to read (default 14)\\n  --json      With --replay: print the report as JSON\\n  --compare <report.json>  With --replay: also print deltas to a saved report\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra drafts --help 1`] = `
"bastra drafts — local session drafts\\n\\nUsage:\\n  bastra drafts [list] [--json]   List unexpired drafts without refreshing them\\n  bastra drafts purge [--json]    Remove all drafts and retained tombstones\\n  bastra drafts undo <id> [--json] [--vault <path>] [--force]\\n                                Remove an unchanged promoted note; keep a 180-day tombstone\\n                                --force permits removing a reviewed edited note\\n  bastra drafts reject <id>... [--json]\\n                                Close open drafts; keep a 180-day tombstone against recapture\\n\\nDrafts stay on this device, outside the vault. Secrets are redacted before\\nstorage. Unshown drafts with one evidence row expire after 7 days (unmeasured);\\nother open drafts expire after 30 days without evidence or display;\\npromoted and rejected rows are retained for 180 days.\\nBASTRA_DRAFTS_PATH overrides the default ~/.bastra/drafts.json location.\\nTyped messages passing the structural noise filter are captured automatically\\nby the local session harvest, with their redacted situation. Retrieval shows\\nunconfirmed quotes separately; BASTRA_DRAFT_HINTS=0 disables that band.\\nBASTRA_PENDING_RELAY=0 stops all relay writes and delivery; retained files stay.\\npurge also clears the pending relay (even when disabled); unreadable relay files are preserved.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra embeddings --help 1`] = `
"bastra embeddings — semantic recall on or off\\n\\nUsage:\\n  bastra embeddings <on|off|status>\\n\\n'on' sets up Ollama plus the embeddinggemma model (~620 MB) and persists the\\nchoice, so recall runs the hybrid path (BM25 + vectors, multilingual).\\n'off' returns to BM25 keyword-only. 'status' shows the effective provider and\\nhow it was resolved (env, setting, or detection).\\n\\n'bastra embeddings' takes no options of its own. To decide the Ollama install\\nnon-interactively, pass --ollama / --no-ollama to 'bastra install' or\\n'bastra update'; on this command they are rejected as a usage error (#536).\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra feedback --help 1`] = `
"bastra feedback — open a prefilled GitHub issue form\\n\\nUsage:\\n  bastra feedback bug\\n  bastra feedback idea\\n\\n'bug' attaches a sanitized diagnostics block: version, OS, node, embedding\\nmode, vault size, daemon status. Never a file path, never vault content. The\\nbrowser opens with the form filled in — you read it and submit it yourself.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra help --help 1`] = `
"bastra help — show the command listing\\n\\nUsage:\\n  bastra help\\n  bastra --help\\n  bastra <command> --help\\n\\nThe last form is the useful one: it prints what that single command does and\\nwhich options apply to it.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra import --help 1`] = `
"bastra import — seed the vault from what you already wrote elsewhere\\n\\nUsage:\\n  bastra import <file|-> [source]     Stage candidates from a list or free text\\n  bastra import rules                 Stage local rules files\\n  bastra import vault <dir> [label]   Import a whole folder of memory files\\n  bastra import clients               Import the clients' own memory folders\\n  bastra import <mine|clear>          Mining queue for a data export\\n  bastra import status                How many candidates are waiting\\n\\nStaging is not saving: candidates land in import-review.md and your next AI\\nsession distills the accepted ones with you. Nothing becomes a memory without\\nyour accept.\\n\\n  rules            CLAUDE.md, AGENTS.md, .cursorrules, .cursor/rules/,\\n                   ~/.claude/CLAUDE.md\\n  vault <dir>      Deterministic folder import into its own isolated subtree\\n                   under memories/imported/ — no per-item review, nothing\\n                   existing is touched\\n  clients          Every ~/.claude/projects/*/memory folder and ~/.codex/memories\\n                   that holds notes, each imported like 'vault' under its own\\n                   label; a re-run only writes what changed\\n  mine             Print the next chunk of a queued conversations.json export\\n  clear            Discard the local mining queue\\n\\nOptions:\\n  --dry-run          Report what would be staged; write nothing\\n  --exclude <glob>   With 'vault': skip matching files (repeatable)\\n  --vault <path>     Import into this vault instead of the configured one\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra install --help 1`] = `
"bastra install — register bastra-recall with an AI client\\n\\nUsage:\\n  bastra install                     Guided setup: pick vault, clients and\\n                                     semantic recall from selection lists\\n  bastra install <surface|all>       Register one surface (or every one)\\n  bastra install claude-desktop --extension\\n                                     Hand the .mcpb Desktop Extension to Claude\\n                                     Desktop instead — the final Install click\\n                                     stays in Desktop's own dialog\\n\\nRegisters the MCP server, the shared skill and the hooks. On a machine with no\\nvault yet it offers to create one first.\\n\\nSurfaces:\\n  claude-desktop  Claude Desktop App\\n  claude-code     Claude Code\\n  codex           Codex + ChatGPT Desktop\\n  cursor          Cursor\\n  all             Every surface above\\n\\nOptions:\\n  --dry-run        Print what would change; write nothing\\n  --vault <path>   Vault path (BASTRA_VAULT_PATH env also works)\\n  --yes, -y        Skip confirmation prompts (e.g. replacing a foreign statusLine)\\n  --ollama         Set up Ollama for semantic recall without asking (~620 MB)\\n  --no-ollama      Skip the Ollama setup — recall stays BM25 keyword-only\\n  --with-bootstrap          Add generated startup instructions (explicit consent)\\n  --no-bootstrap            Skip the startup instruction offer\\n  --no-stop-hook   Skip the Stop save-eval hook (registered by default)\\n  --stub           Download the compiled hook client without asking (~70 MB; faster hook start)\\n  --no-stub        Keep the node hook client — no download, remembered for updates\\n  --extension      claude-desktop only: install via the .mcpb extension\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra logs --help 1`] = `
"bastra logs — what the hooks and the daemon actually recorded\\n\\nUsage:\\n  bastra logs [-f] [--since <duration>] [--source <src>] [--lines <n>]\\n  bastra logs --stats [--since <duration>]\\n  bastra logs --conventions [--since <duration>]\\n\\nOne line per event, newest last. --stats aggregates per trigger lane instead\\n(median/p90/max latency, timeouts) — that is the view the hook budget is\\nmeasured against.\\n\\nOptions:\\n  -f, --follow           Keep printing new entries as they arrive\\n  --since <duration>     How far back: 30s, 10min, 2h, 1d (default 5min;\\n                         with --stats the default is 7d)\\n  --source <daemon|hook|all>\\n                         Which log source to read (default all)\\n  --lines <n>            Cap the number of lines printed (default 200)\\n  --conventions          Per-session shown/loaded/gate/receipt evidence\\n  --stats                Aggregate per lane instead of printing lines\\n  --include-eval         With --stats: also count eval/synthetic-marked rows\\n                         (excluded by default, #619)\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra map --help 1`] = `
"bastra map — the vault as an interactive graph\\n\\nUsage:\\n  bastra map\\n\\nOpens the local map in your browser: memories, their links and the clusters\\nthey form. Local only — the page is served by the daemon on 127.0.0.1 and\\nnothing leaves the machine. If the map is off, the command offers to enable it\\nand starts the daemon that serves it.\\n\\nAlias: bastra ui\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra models --help 1`] = `
"bastra models — the local text model for memory rewriting\\n\\nUsage:\\n  bastra models [status]\\n  bastra models recommend\\n  bastra models set <tag>\\n  bastra models switch <recommendation> <model>\\n  bastra models later <recommendation>\\n  bastra models dismiss <recommendation>\\n\\nThe model behind doc2query trigger expansion and the local reranker — not the\\nembedding model ('bastra embeddings' owns that one).\\n\\n  status      Active model plus this machine's RAM-tier recommendation\\n  recommend   What this machine can carry, without changing anything\\n  set <tag>   Pull a model and persist it (e.g. gemma4:12b on a 24 GB+ box)\\n\\nNew installs are offered tev1:4b from 16 GB of RAM (gemma4:12b as the\\nalternative from 24 GB, and as the suggestion from 32 GB). An install that\\nnever stored a choice keeps running the built-in fallback gemma3:4b.\\n\\nA release can recommend a different model. bastra never switches on its own:\\n'bastra update', the first command on a terminal after an update, the session\\nstart and a line after CLI commands tell you until you have answered. Session\\nstart normally shows it once per UTC day across Claude Code and Codex, with its\\nown marker independent of the CLI line. Simultaneous session starts reclaiming\\nan orphaned lock can rarely show it twice on the same day. 'status' shows the\\nrecommendation at any time.\\nEvery notice prints the exact commands; they name the recommendation they\\nanswer, and bastra refuses an answer to a different one.\\n\\n  switch      Pull the recommended model, check it with a short test call, and\\n              only then store it together with your answer. If anything fails,\\n              nothing changes. The old model stays installed; 'set <old tag>'\\n              switches back.\\n  later       Keep the current model and ask again in 7 days\\n  dismiss     Keep the current model and do not ask again for this\\n              recommendation (a later, new recommendation asks again). The\\n              notice then does not come back, and you may be giving up better\\n              recall quality; 'status' keeps showing the recommendation and\\n              you can still switch later.\\n\\nBASTRA_UPDATE_CHECK=off (or update.mode off) silences the notice as well.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra oauth --help 1`] = `
"bastra oauth — remote MCP clients approved through the OAuth login\\n\\nUsage:\\n  bastra oauth [list] [--json]\\n  bastra oauth revoke <client_id>\\n  bastra oauth revoke all\\n\\nChatGPT and claude.ai custom connectors reach /api/v1/mcp with OAuth. Each\\none registers itself, and you approve it once by entering your API token\\n('bastra token') on the daemon's login page. Their tokens only open the MCP\\ndoor, never the other /api/v1 routes.\\n\\n  list     Every registered client: name, redirect host, grants, last token\\n  revoke   Remove a client and all its tokens; takes effect on the next request\\n\\nOptions:\\n  --json   Machine-readable output\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra onboard --help 1`] = `
"bastra onboard — the 5-minute interview that seeds a fresh vault\\n\\nUsage:\\n  bastra onboard\\n  bastra onboard --answers <file>\\n  bastra onboard skip\\n  bastra onboard done\\n\\nPersona-aware questions whose answers each become a profile memory, so recall\\nhas something to work with on day one instead of an empty vault.\\n\\n  skip              Dismiss the nudge — run 'bastra onboard' whenever you want it\\n  done              Mark onboarding as completed without running the interview\\n  --answers <file>  Save the answers from a file instead of asking (no TTY\\n                    needed): JSON (.json) or YAML, e.g.\\n                      persona: developer        # developer|business|personal|mixed\\n                      answers:\\n                        identity: Alex · English, informal\\n                        stack: TypeScript + Node\\n                    Answer ids are the interview's question ids (identity,\\n                    rules, stack, projects, workflow, conventions_size, ...).\\n                    An unknown id is reported and skipped. The file fails\\n                    (exit 2, onboarding stays open) when nothing in it is\\n                    usable and an entry was skipped: an unknown id or a value\\n                    that is not text. Only the persona is a valid file.\\n  --vault <path>    Onboard this vault instead of the configured one\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra patches --help 1`] = `
"bastra patches — local changes that survive an update\\n\\nUsage:\\n  bastra patches [list]\\n  bastra patches add <file.patch>\\n  bastra patches remove <id>\\n  bastra patches status\\n\\nAn ordered series reapplied onto the fresh install after every update. A patch\\nupstream has absorbed is retired; one that no longer applies is set aside and\\nreported — never forced.\\n\\n  status   Probe the series against what is installed right now\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra recall --help 1`] = `
"bastra recall — search the vault from the terminal\\n\\nUsage:\\n  bastra recall \\"<question>\\" [--limit N] [--scope S] [--type T] [--json]\\n  bastra recall --load <id> [--json]\\n\\nAsks the running daemon the same recall agents use (MCP recall /\\nREST /api/v1/recall) and prints the matching memories: id, type and area,\\ntitle, summary. --limit caps the hits (1-20, default 5); --scope and --type\\nnarrow to one area or memory type. --json prints the daemon's answer as is,\\nfor scripts. Private memories are not shown here, the same as over REST.\\n\\nUse --load with an id from the hit list to print the complete Markdown body\\nthrough the daemon's load_memory handler. Add --json for the raw load response.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra reconcile --help 1`] = `
"bastra reconcile — two stores of the same vault: which copy is ahead\\n\\nUsage:\\n  bastra reconcile [--vault <this-store>]                  list the copies of this vault\\n  bastra reconcile <other-store> [--vault <this-store>]   the plan (dry run, default)\\n  bastra reconcile <other-store> --yes                     carry out the copies\\n  bastra reconcile <other-store> --json                    the plan as JSON\\n\\nWithout <other-store> it looks for copies: vault paths in the client\\nregistrations (Claude Code, also per project; Claude Desktop, Cursor, Codex)\\nand BASTRA_VAULT_PATH — where a forwarder-spawned daemon writes when the\\nconfigured one is unreachable —, symlinks onto a store, and folders with a\\nbastra audit log in sync folders (iCloud Drive, ~/Library/CloudStorage,\\nDropbox, OneDrive, Google Drive, Nextcloud, pCloud, ~/Sync). A sync-folder\\nhit counts as a copy when its audit log shares a memory with this vault's.\\nWith exactly one other copy it prints the dry run against it; --yes always\\ntakes the store as an argument.\\n\\nCompares memory by memory, joined by the frontmatter id. mtime, hash and size\\nsay nothing here: the daemon rewrites files on its own (generated fields, the\\nauto-related block). Two copies count as the same when their authored content\\nmatches — body without the generated block, wrapping collapsed, wikilinks in\\none spelling, frontmatter without generated fields.\\n\\nWhich side is ahead comes from each store's audit log\\n(.bastra/audit-log.ndjson): the side with writes the other lacks. Writes on\\nboth sides, a change neither log records (an edit in another editor), a\\ndelete on one side, or a duplicate id is a conflict: listed, never resolved.\\n\\n--yes copies only the unambiguous cases. An overwritten file is first copied\\nto <store>/.bastra/reconcile-backup/<time>/; a file that changed since the\\nplan is skipped. The copied memory's audit entries go along, so the next run\\nstill knows the order. Nothing is deleted. Exit code 1 if a copy was skipped.\\n\\nNot the daemon's periodic vault reindex (BASTRA_VAULT_RECONCILE_MS).\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra rules --help 1`] = `
"bastra rules — write a client's memory rules into a project\\n\\nUsage:\\n  bastra rules cursor [path]\\n  bastra rules remove cursor [path]\\n  bastra rules proposals\\n  bastra rules confirm|reject <id> <revision> user-directed\\n\\nProposals prints the full rule text and current revision. Confirm or reject only\\non the user's explicit decision in chat. user-directed attests that instruction;\\nit does not authenticate a human. Stale revisions are refused.\\n\\nWrites .cursor/rules/bastra-recall.mdc into the project (default: the current\\ndirectory). Cursor keeps rules per repository — there is no global equivalent,\\nso this is run once per project.\\n\\nClaude Code and Claude Desktop do not need this: they use the shared skill,\\ninstalled by 'bastra install'.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra save --help 1`] = `
"bastra save — save a memory yourself\\n\\nUsage:\\n  bastra save --title T --type T --scope S [options] [text]\\n  echo \\"text\\" | bastra save --title T --type T --scope S\\n\\nOptions:\\n  --summary S          one line for the hit list (default: the text's first line)\\n  --recall-when W      when it should come up; repeatable (default: the title)\\n  --tag X              repeatable (default: the scope)\\n  --topic a/b          topic path (default: the scope)\\n  --dry-run            show what would be saved (file, rule or note); writes nothing\\n  --json               print the daemon's answer as is\\n\\nThe text is the words after the options, or what is piped in. --type is one of\\nreference, project-fact, decision, lesson, workflow, preference,\\nuser-preference, meta-working. The save goes through the running daemon's\\nsave_memory path with every check an agent's save gets (claim gate,\\ncredential redaction, audit, indexing) and is recorded as your own instruction\\n(write_origin: user-directed). A save another memory already covers is held,\\nnot written: the command names that memory and exits 1. An existing memory\\nwith the same title is not overwritten.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra skills --help 1`] = `
"bastra skills — declare link targets that live on another surface\\n\\nUsage:\\n  bastra skills [list]\\n  bastra skills add <id> [label]\\n  bastra skills remove <id>\\n\\nA memory may link to a Claude Code skill that is not a file in your vault.\\nDeclared ids render in the map's skills ring instead of as unwritten ghosts.\\nDeclaration only: no path, no scan, no sync.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra status --help 1`] = `
"bastra status — is the daemon up, and what is it serving\\n\\nUsage:\\n  bastra status [--json] [-q]\\n\\nPrints daemon reachability, vault size, the effective embedding provider and\\nhow it was resolved. Reads only — nothing is registered, restarted or written.\\n\\nOptions:\\n  --json      Machine-readable output\\n  -q, --quiet Print nothing; the exit code carries the answer (0 = ok)\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra suggestions --help 1`] = `
"bastra suggestions — exact save proposal decisions\\n\\nUsage:\\n  bastra suggestions reject <proposal_id> user-directed \\"explicit user rejection\\"\\n  bastra suggestions reset <proposal_id> user-directed\\n\\nOnly report a user's explicit rejection of a displayed proposal. Silence,\\nnot saving and an agent's assessment do not count. Rejection suppresses only\\nthat proposal in this project; reset restores it. Other suggestions, trigger\\nstrength and binding rules stay unchanged. --dry-run prints the request.\\nThe agent attests user direction, as with rule proposal decisions.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra tasks --help 1`] = `
"On by default since v1.2.0. Turn off: tasks.enabled=false or BASTRA_TASKS=0; restart the daemon and the clients/hooks.\\n\\nbastra tasks — tasks and reminders (on next contact)\\nUsage: bastra tasks <create|list|due|status|setup-hooks|client-status|ui> [options]\\nFirst access: tasks auth mint owner me personal ~/.bastra/owner-task.token.\\nCopy the token in a local editor; enter it only hidden, in the terminal/browser.\\nOptional tasks owner-login: private storage only for the interactive owner CLI, never hooks/MCP.\\nThen tasks setup-hooks, tasks client-status, tasks create --goal \\"Test\\" --after 1m --arm.\\nOnce due: tasks due, tasks acknowledge ID --occurrence OCCURRENCE, tasks resolve ID.\\nArming = review; rearm explicitly sets it back to UNARMED for a new review.\\n  bastra tasks create --goal \\"Evaluate after seven days\\" --after 7d --domain personal --timezone Europe/Madrid --arm\\n  bastra tasks create --goal \\"Check daily\\" --when 2026-10-12T18:00 --timezone Europe/Madrid --every 1d --count 3\\n  bastra tasks create --goal \\"Check appointment\\" --when 2026-10-12T18:00 --timezone Europe/Madrid --expires 2026-10-13T18:00\\n  bastra tasks edit ID --expires none   (remove the end of validity)\\n  bastra tasks list | due | status [--json] [--agent]\\n  bastra tasks mute|unmute|off|on|stop|resume  Global owner controls\\n  bastra tasks get|review|resolve|cancel|rearm|delete <id>\\n  bastra tasks pause|resume|end-series <id>  Pause, resume or end a series\\n  Repetition: --every 1d also without --count/--end; resolve completes one occurrence only.\\n  bastra tasks acknowledge <id> --occurrence <occurrence-id>\\n  bastra tasks snooze <id> --until 2026-10-13T18:00\\n  bastra tasks targets register demo --root DIRECTORY --path artifact.txt --domain personal\\n  bastra tasks targets update ID --root DIR --path FILE --domain DOMAIN\\n  bastra tasks targets remove ID --agent  Remove an instructed target, stop execution\\n  bastra tasks targets list       Existing local reversible targets, no provider\\n  bastra tasks archive ID         Completed work only; run tasks stop first\\n  bastra tasks archive-restore ARCHIVE_ID  Bring back history/rollback, unarmed\\n  bastra tasks recover [--lock]   Owner offline: stop processes, keep backup/original\\n  bastra tasks setup-hooks        Owner sets up local hook cards with their own agent credential\\n  bastra tasks client-status      Shows a missing/revoked client credential honestly\\n  bastra tasks <operation> --input input.json  Advanced/machine input\\nThe owner credential is asked for hidden on the terminal; --agent uses the assigned\\nclient credential. Instructed tasks are created armed directly with --agent;\\n--agent --arm is allowed for every task level without further owner approval. Without\\nan agent instruction, creating stays unarmed by default. For execute too, the user's\\ninstruction in chat is the approval.\\n--after 7d is an elapsed duration; --when without an offset uses the named time zone.\\nAcknowledged means seen, not done. Small hook cards: bastra tasks due.\\n  bastra tasks auth mint|rotate owner|agent actor domain[,domain] new-token-file [old-id]\\n  bastra tasks auth revoke credential-id\\n  bastra tasks execution-enable --agent  Enable an instructed local adapter, lift the stop\\n  bastra tasks release LEASE_ID   Release your own reservation; renews no approval\\n  bastra tasks prepare --agent --input input.json\\nMachine input: authorization {write_origin:\\"user-directed\\", session_id, program,\\nuser_request, at}. The agent passes on the user's instruction; Recall does not\\nevaluate its wording. For its own consequential proposals, ask once in chat and\\nrecord the yes the same way. No keys, passphrase or second confirmation.\\nHistorical signature commands are kept for old data only. No background wakeup;\\nBASTRA_TASK_TOKEN overrides the private local hook configuration.\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra token --help 1`] = `
"bastra token — the REST API token for browser and REST clients\\n\\nUsage:\\n  bastra token [--origin <url>]\\n  bastra token rotate\\n  bastra token clear\\n\\nPrints the token, minting one on first use. Browser clients also need their\\nOrigin allowlisted — '--origin https://bastra.io' does that in the same step,\\nso no plist or env editing is needed.\\n\\n  rotate   Issue a fresh token; the old one stops working immediately\\n  clear    Remove it — locks out every browser/REST client until a new one is\\n           minted\\n\\nOptions:\\n  --origin <url>  Allowlist this browser Origin as well\\n  --json          Machine-readable output\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra trash --help 1`] = `
"bastra trash — archived memories, back from the vault trash\\n\\nUsage:\\n  bastra trash list              archived memories that can be restored (newest first)\\n  bastra trash restore <id>      put an archived memory back where it lived\\n\\narchive_memory (and Archive in the memory browser) moves a memory into the\\nvault trash, <vault>/.bastra/trash/ — never a hard delete. This command asks\\nthe running daemon (restore_memory) to list or restore them; the restore is\\nwritten to the vault's audit log. A memory with the same id that is live\\nagain is not overwritten: the restore is refused. Private memories are not\\nlisted or restored here; restore them in the memory browser.\\n--json prints the list as JSON.\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra ui --help 1`] = `
"bastra ui — alias for 'bastra map'\\n\\nUsage:\\n  bastra ui\\n  bastra ui remote on <https-address>\\n  bastra ui remote off\\n  bastra ui remote status\\n\\nWithout a subcommand it opens the vault map in your browser. See\\n'bastra map --help'.\\n\\n  remote on      Allow the web UI through your tunnel at this public address\\n                 (https only, no path), e.g. https://recall.example.com. The\\n                 tunnel must let '/ui' through. Sign-in with the account is the\\n                 only protection from outside; without an account ('bastra\\n                 account setup') nobody gets in. Takes effect at once.\\n  remote off     Clear the address and end every public session at once\\n  remote status  Whether remote access is on, and its address\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra uninstall --help 1`] = `
"bastra uninstall — remove the registration from an AI client\\n\\nUsage:\\n  bastra uninstall <surface|all>\\n\\nRemoves the MCP server entry, the hooks and the statusline segment. The shared\\nskill is removed once no surface references it anymore. Your vault is never\\ntouched — uninstalling a client does not delete a single memory.\\n\\nSurfaces:\\n  claude-desktop  Claude Desktop App\\n  claude-code     Claude Code\\n  codex           Codex + ChatGPT Desktop\\n  cursor          Cursor\\n  all             Every surface above\\n\\nOptions:\\n  --dry-run   Print what would be removed; write nothing\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra update --help 1`] = `
"bastra update — upgrade, re-register, restart\\n\\nUsage:\\n  bastra update [options]\\n\\nUpgrades the installed package (brew upgrade when brew-installed; for a global\\nnpm install the package you installed: 'npm install -g bastra-recall@latest',\\nor '@bastra-recall/daemon@latest' when you installed that one; nothing for a\\nsource checkout), re-registers every surface and restarts the daemon.\\n\\nA source checkout is never pulled, installed or built by this command: it only\\nverifies that the checkout's build is not older than its sources, and stops\\nwithout re-registering or restarting when it is. So there, run\\n'git pull && npm ci && npm run build' yourself first, then 'bastra update'.\\n\\nBefore replacing an in-place installation it runs a preflight: locally modified\\nfiles are backed up to ~/.bastra/update-backups/<version>/ and reported. A\\nregistered patch series (see 'bastra patches') is reapplied afterwards.\\n\\nOptions:\\n  --dry-run   Describe every step, change nothing\\n  --staged    Swap the files only, no daemon restart — the unattended\\n              auto-update path; a blocked update is recorded instead of forced\\n  --force     Install even though locally modified files were found. They are\\n              backed up either way. Never applies to the unattended auto-update\\n  --yes, -y   Skip confirmation prompts during the re-registration\\n\\nMore: bastra help\\n"
`;

exports[`#1532 golden master — bastra version --help 1`] = `
"bastra version — print the version of this CLI\\n\\nUsage:\\n  bastra version\\n  bastra --version\\n\\nNote this is the CLI's own version. 'bastra status' reports what the RUNNING\\ndaemon serves, which differs when its code was replaced under it (#329).\\n\\nMore: bastra help\\n"
`;

